-- 更新自动创建profile的触发器，使用手机号和姓名
CREATE OR REPLACE FUNCTION handle_new_user()
RETURNS TRIGGER AS $$
BEGIN
  INSERT INTO profiles (id, role, name)
  VALUES (
    NEW.id, 
    'parent', 
    COALESCE(NEW.raw_user_meta_data->>'name', NEW.raw_user_meta_data->>'phone', '新用户')
  );
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;