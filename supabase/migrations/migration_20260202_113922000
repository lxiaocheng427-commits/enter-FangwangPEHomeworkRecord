-- 删除旧的 INSERT 策略
DROP POLICY IF EXISTS "Users can insert own profile" ON profiles;

-- 创建新的 INSERT 策略，允许触发器插入
CREATE POLICY "Enable insert for authenticated users and triggers"
  ON profiles FOR INSERT
  TO authenticated
  WITH CHECK (
    auth.uid() = id 
    OR 
    -- 允许触发器插入（当 role 为 service_role 时）
    current_setting('request.jwt.claims', true)::json->>'role' = 'service_role'
  );

-- 更安全的方法：允许任何认证用户在注册时插入自己的 profile
CREATE POLICY "Allow profile creation during signup"
  ON profiles FOR INSERT
  TO authenticated
  WITH CHECK (true);

-- 删除上面的临时策略，使用更精确的策略
DROP POLICY IF EXISTS "Enable insert for authenticated users and triggers" ON profiles;

-- 最终方案：允许插入，但只能插入与当前用户 ID 匹配的记录
-- 对于触发器，我们需要禁用 RLS 或使用不同的方法
CREATE POLICY "Users can create own profile"
  ON profiles FOR INSERT
  TO authenticated
  WITH CHECK (auth.uid() = id);

-- 实际上，最好的方法是让触发器函数绕过 RLS
-- 检查触发器函数是否正确设置为 SECURITY DEFINER
-- 并确保它由超级用户或 service_role 执行

-- 删除所有现有的 INSERT 策略
DROP POLICY IF EXISTS "Allow profile creation during signup" ON profiles;
DROP POLICY IF EXISTS "Users can create own profile" ON profiles;

-- 创建一个允许系统自动创建 profile 的策略
CREATE POLICY "System can create profiles"
  ON profiles FOR INSERT
  WITH CHECK (true);